---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
---

<BaseLayout
  title="Message sent | Siya Labs"
  description="Thank you for contacting Siya Labs."
  og="contact"
  noindex
>
  <section class="section">
    <div class="container-site max-w-3xl">
      <span class="grid size-12 place-items-center rounded-full bg-pine text-ivory"><Icon name="check" class="size-6" /></span>
      <h1 class="h1 mt-8">Thank you. Your message is on its way.</h1>
      <p class="lede mt-6">We will reply to the email address you provided.</p>
      <a href="/" class="btn btn-secondary mt-10">Back to home</a>
    </div>
  </section>
</BaseLayout>
