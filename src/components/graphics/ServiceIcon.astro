---
/** 24px line icons for the five services (1.5px stroke). Decorative. */
import type { ServiceSlug } from '../../data/services';

interface Props {
  slug: ServiceSlug;
  class?: string;
}
const { slug, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    slug === 'ai-automation' && (
      <>
        <circle cx="4.75" cy="12" r="2" />
        <circle cx="12" cy="12" r="2.75" />
        <circle cx="19.25" cy="5.75" r="2" />
        <circle cx="19.25" cy="18.25" r="2" />
        <path d="M6.75 12h2.5M14.2 10.3l3.3-3.1M14.2 13.7l3.3 3.1" />
      </>
    )
  }
  {
    slug === 'cybersecurity' && (
      <>
        <path d="M12 3.25 19 6v5.6c0 4.1-2.9 7.6-7 8.9-4.1-1.3-7-4.8-7-8.9V6z" />
        <path d="m9 12 2.1 2.1L15.2 10" />
      </>
    )
  }
  {slug === 'ai-software-testing' && <path d="m4 7.5 1.6 1.6 3.2-3.2M4 16.5l1.6 1.6 3.2-3.2M12 7.5h8M12 16.5h8" />}
  {slug === 'software-development' && <path d="M8.5 7.5 4 12l4.5 4.5M15.5 7.5 20 12l-4.5 4.5M13.3 5.25l-2.6 13.5" />}
  {
    slug === 'ai-assistants' && (
      <>
        <path d="M4.5 6.5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2V14a2 2 0 0 1-2 2H11l-4 3.5V16h-.5a2 2 0 0 1-2-2z" />
        <path d="M8.6 10.3h.01M12 10.3h.01M15.4 10.3h.01" stroke-width="2.2" />
      </>
    )
  }
</svg>
