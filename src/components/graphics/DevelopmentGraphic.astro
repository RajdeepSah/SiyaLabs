---
/**
 * Web & Software Development: an interface assembles on a 12-column layout
 * grid while an API (backed by a database) feeds it data.
 * Frame 0 = the assembled interface.
 */
interface Props {
  label: string;
  class?: string;
}
const { label, class: className = '' } = Astro.props;
const colW = (254 - 11 * 6) / 12;
const cols = Array.from({ length: 12 }, (_, i) => +(58 + i * (colW + 6)).toFixed(2));
const cards = [58, 147, 236];
---

<svg class={`gfx ${className}`} viewBox="0 0 480 360" role="img" aria-label={label} data-animate>
  <g class="cols">
    {cols.map((x) => <rect x={x} y="92" width={colW.toFixed(2)} height="204" />)}
  </g>

  <rect class="ln" x="40" y="52" width="290" height="256" rx="12"></rect>
  <path class="ln" d="M40 82H330"></path>
  <circle class="chrome" cx="58" cy="67" r="3.5"></circle>
  <circle class="chrome" cx="71" cy="67" r="3.5"></circle>
  <circle class="chrome" cx="84" cy="67" r="3.5"></circle>
  <rect class="addr" x="108" y="61" width="162" height="12" rx="6"></rect>

  <g class="b b-nav">
    <rect class="ink" x="58" y="96" width="14" height="14" rx="3"></rect>
    <path class="ln soft" d="M232 103H252M262 103H282M292 103H312"></path>
  </g>
  <g class="b b-hero">
    <rect class="ink" x="58" y="126" width="164" height="12" rx="3"></rect>
    <rect class="ink" x="58" y="144" width="126" height="12" rx="3"></rect>
    <rect class="faint" x="58" y="166" width="150" height="6" rx="3"></rect>
  </g>
  <g class="b b-cta">
    <rect class="cta" x="58" y="184" width="62" height="20" rx="10"></rect>
  </g>
  <g class="b b-img">
    <rect class="tint" x="238" y="126" width="74" height="78" rx="8"></rect>
    <circle class="faint" cx="258" cy="146" r="6"></circle>
    <path class="faint" d="M246 196L270 170L284 184L294 175L306 196Z"></path>
  </g>
  <g class="b b-cards">
    {
      cards.map((x) => (
        <g>
          <rect class="ln soft card" x={x} y="222" width="76" height="70" rx="8" />
          <rect class="faint" x={x + 10} y="232" width="12" height="12" rx="3" />
          <path class="ln soft" d={`M${x + 10} 262H${x + 62}M${x + 10} 274H${x + 46}`} />
        </g>
      ))
    }
  </g>

  <!-- API + database -->
  <rect class="ln" x="372" y="148" width="64" height="64" rx="14"></rect>
  <path
    class="ln"
    d="M398 165C392 165 392 169 392 173V176C392 179 390 180 388 180C390 180 392 181 392 184V187C392 191 392 195 398 195M410 165C416 165 416 169 416 173V176C416 179 418 180 420 180C418 180 416 181 416 184V187C416 191 416 195 410 195"
  ></path>
  <path class="ln soft dashed" d="M404 212V252"></path>
  <ellipse class="ln" cx="404" cy="260" rx="26" ry="8"></ellipse>
  <path class="ln" d="M378 260V286A26 8 0 0 0 430 286V260"></path>
  <path class="ln soft" d="M378 273A26 8 0 0 0 430 273"></path>

  <path class="ln soft" d="M372 180H330"></path>
  <path class="pulse p1" d="M372 180H330" pathLength="1"></path>
  <path class="pulse p2" d="M372 180H330" pathLength="1"></path>
  <path class="pulse p3" d="M372 180H330" pathLength="1"></path>
</svg>

<style>
  .soft {
    stroke-opacity: 0.4;
  }
  .dashed {
    stroke-dasharray: 3 5;
  }
  .cols rect {
    fill: currentColor;
    fill-opacity: 0.04;
    animation: dev-cols 6.4s ease infinite both;
  }
  .chrome {
    fill: currentColor;
    fill-opacity: 0.25;
  }
  .addr {
    fill: currentColor;
    fill-opacity: 0.08;
  }
  .ink {
    fill: currentColor;
    fill-opacity: 0.85;
  }
  .faint {
    fill: currentColor;
    fill-opacity: 0.22;
  }
  .tint {
    fill: currentColor;
    fill-opacity: 0.09;
  }
  .ln.card {
    fill: currentColor;
    fill-opacity: 0.03;
  }
  .cta {
    fill: var(--color-terracotta);
  }
  .b-nav { animation: dev-nav 6.4s var(--ease-brand) infinite both; }
  .b-hero { animation: dev-hero 6.4s var(--ease-brand) infinite both; }
  .b-cta { animation: dev-cta 6.4s var(--ease-brand) infinite both; transform-box: fill-box; transform-origin: center; }
  .b-img { animation: dev-img 6.4s var(--ease-brand) infinite both; }
  .b-cards { animation: dev-cards 6.4s var(--ease-brand) infinite both; }
  .pulse {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 0.22 2;
    stroke-dashoffset: 0.22;
    opacity: 0;
    animation: dev-pulse 6.4s var(--ease-flow) infinite both;
  }
  .p1 { animation-delay: 0.5s; }
  .p2 { animation-delay: 1.5s; }
  .p3 { animation-delay: 2.5s; }

  @keyframes dev-cols {
    0%, 4% { fill-opacity: 0.04; }
    9%, 46% { fill-opacity: 0.08; }
    54%, 100% { fill-opacity: 0.04; }
  }
  @keyframes dev-nav {
    0%, 3% { opacity: 1; translate: 0 0; }
    8%, 12% { opacity: 0; translate: 0 8px; }
    17%, 100% { opacity: 1; translate: 0 0; }
  }
  @keyframes dev-hero {
    0%, 3% { opacity: 1; translate: 0 0; }
    8%, 18% { opacity: 0; translate: 0 8px; }
    23%, 100% { opacity: 1; translate: 0 0; }
  }
  @keyframes dev-cta {
    0%, 3% { opacity: 1; scale: 1; }
    8%, 28% { opacity: 0; scale: 0.6; }
    32%, 100% { opacity: 1; scale: 1; }
  }
  @keyframes dev-img {
    0%, 3% { opacity: 1; translate: 0 0; }
    8%, 34% { opacity: 0; translate: 0 8px; }
    39%, 100% { opacity: 1; translate: 0 0; }
  }
  @keyframes dev-cards {
    0%, 3% { opacity: 1; translate: 0 0; }
    8%, 42% { opacity: 0; translate: 0 8px; }
    48%, 100% { opacity: 1; translate: 0 0; }
  }
  @keyframes dev-pulse {
    0% { stroke-dashoffset: 0.22; opacity: 0; }
    2% { opacity: 1; }
    12% { stroke-dashoffset: -1; opacity: 1; }
    13%, 100% { stroke-dashoffset: -1; opacity: 0; }
  }
</style>
