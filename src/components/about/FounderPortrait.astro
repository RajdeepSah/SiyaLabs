---
/**
 * Founder portrait. Default is the warm monochrome treatment (matches the
 * ivory/pine palette); pass tone="natural" for the original colour crop.
 * Both are generated by scripts/build-portrait.mjs.
 */
import { Picture } from 'astro:assets';
import mono from '../../assets/founder/rajdeep-sah-mono.jpg';
import natural from '../../assets/founder/rajdeep-sah.jpg';

interface Props {
  class?: string;
  sizes?: string;
  tone?: 'mono' | 'natural';
  loading?: 'lazy' | 'eager';
}
const {
  class: className = '',
  sizes = '(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 90vw',
  tone = 'mono',
  loading = 'lazy',
} = Astro.props;
---

<div class={`portrait ${className}`}>
  <Picture
    src={tone === 'mono' ? mono : natural}
    alt="Portrait of Rajdeep Sah, founder and CEO of Siya Labs"
    widths={[360, 520, 720, 960]}
    sizes={sizes}
    formats={['avif', 'webp']}
    quality={74}
    loading={loading}
    class="portrait-img"
  />
</div>

<style>
  .portrait {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    aspect-ratio: 4 / 5;
    background: var(--color-surface-strong);
  }
  .portrait :global(.portrait-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
