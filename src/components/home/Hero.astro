---
import HeroMark from '../graphics/HeroMark.astro';
import Icon from '../ui/Icon.astro';
---

<section class="hero" data-parallax aria-labelledby="hero-title">
  <div class="container-site grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-6">
    <div class="hero-copy lg:col-span-7">
      <p class="eyebrow hero-in">Applied AI · Cybersecurity · Software</p>
      <h1 id="hero-title" class="hero-title">
        <span class="line">Intelligent software,&#32;</span><span class="line">built with intention.</span>
      </h1>
      <p class="lede hero-in d2 mt-7 max-w-[36rem]">
        We design and build AI automation, intelligent assistants, security tools, automated testing, and
        custom software that businesses can rely on.
      </p>
      <div class="hero-in d3 mt-10 flex flex-wrap items-center gap-3">
        <a href="/contact/" class="btn btn-primary">Get in touch <Icon name="arrow-right" /></a>
        <a href="/services/" class="btn btn-secondary">Explore services</a>
      </div>
    </div>
    <div class="lg:col-span-5">
      <div class="hero-visual">
        <HeroMark />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 0.5rem + 6vw, 6rem) clamp(4.5rem, 2rem + 7vw, 8rem);
  }
  .hero-copy {
    container-type: inline-size;
  }
  @media (max-width: 30rem) {
    .hero-copy .eyebrow {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      gap: 0.6rem;
    }
  }
  .hero-title {
    margin-top: 1.5rem;
    font-size: clamp(2.5rem, 10cqi, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.038em;
  }
  @media (min-width: 64rem) {
    .hero-title .line {
      display: block;
    }
  }
  .hero-visual {
    max-width: 24rem;
    margin-inline: auto;
  }
  @media (min-width: 64rem) {
    .hero-visual {
      max-width: none;
      margin-right: -1rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 1s var(--ease-brand) both;
    }
    .d2 {
      animation-delay: 0.12s;
    }
    .d3 {
      animation-delay: 0.24s;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
</style>
