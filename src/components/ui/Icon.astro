---
/** Small line icons (24px grid, 1.5px stroke). Decorative by default. */
type Name = 'arrow-right' | 'arrow-up-right' | 'arrow-up' | 'menu' | 'close' | 'check' | 'mail' | 'external';
interface Props {
  name: Name;
  class?: string;
}
const { name, class: className } = Astro.props;
const paths: Record<Name, string> = {
  'arrow-right': 'M4 12h15M13 6l6 6-6 6',
  'arrow-up-right': 'M7 17 17 7M9 7h8v8',
  'arrow-up': 'M12 20V5M6 11l6-6 6 6',
  menu: 'M4 8h16M4 16h16',
  close: 'M6 6l12 12M18 6 6 18',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  mail: 'M3.5 6.5h17v11h-17zM4 7l8 6 8-6',
  external: 'M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
