---
/**
 * Contact form. With PUBLIC_WEB3FORMS_KEY set it posts to Web3Forms (JSON via
 * fetch, or a normal POST without JS). Without a key it falls back to a
 * pre-filled email, so it never silently fails.
 */
import { SITE, abs } from '../../config/site';
import { services } from '../../data/services';
import Icon from '../ui/Icon.astro';

const key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const endpoint = key ? 'https://api.web3forms.com/submit' : '';
const interests = [...services.map((s) => s.name), 'Something else'];
---

<form
  class="contact-form"
  action={endpoint || `mailto:${SITE.email}`}
  method="post"
  enctype={endpoint ? undefined : 'text/plain'}
  novalidate
  data-contact-form
  data-endpoint={endpoint}
  data-email={SITE.email}
>
  {key && <input type="hidden" name="access_key" value={key} />}
  {key && <input type="hidden" name="redirect" value={abs('/contact/thanks/')} />}
  <input type="hidden" name="subject" value="New inquiry from the Siya Labs website" />
  <input type="hidden" name="from_name" value="Siya Labs website" />

  <div class="hp" aria-hidden="true">
    <label>Leave this field empty <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div class="field">
      <label for="cf-name">Name</label>
      <input
        id="cf-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        maxlength="120"
        aria-describedby="cf-name-error"
      />
      <p class="error" id="cf-name-error" data-error-for="name"></p>
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="200"
        aria-describedby="cf-email-error"
      />
      <p class="error" id="cf-email-error" data-error-for="email"></p>
    </div>
  </div>

  <div class="field mt-6">
    <label for="cf-company">Company <span class="optional">(optional)</span></label>
    <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="160" />
  </div>

  <fieldset class="mt-8">
    <legend>What can we help with? <span class="optional">(optional)</span></legend>
    <div class="chips mt-3">
      {
        interests.map((label) => (
          <label class="chip">
            <input type="checkbox" name="interests" value={label} />
            <span>{label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="field mt-8">
    <label for="cf-message">Message</label>
    <textarea
      id="cf-message"
      name="message"
      rows="6"
      required
      minlength="10"
      maxlength="5000"
      aria-describedby="cf-message-hint cf-message-error"></textarea>
    <p class="hint" id="cf-message-hint">A few sentences about your goals, timeline, or the problem you want to solve.</p>
    <p class="error" id="cf-message-error" data-error-for="message"></p>
  </div>

  <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
    <button type="submit" class="btn btn-primary" data-submit>Send message <Icon name="arrow-right" /></button>
    <p class="status" role="status" aria-live="polite" data-status></p>
  </div>
</form>

<div class="success" hidden tabindex="-1" data-success>
  <span class="success-icon"><Icon name="check" class="size-6" /></span>
  <h2 class="h3 mt-6">Thank you. Your message is on its way.</h2>
  <p class="muted mt-3">We will reply to the email address you provided.</p>
</div>

<script>
  import '../../scripts/contact-form';
</script>

<style>
  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  label,
  legend {
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .optional {
    font-weight: 400;
    color: var(--color-ink-muted);
  }
  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    min-height: 3.125rem;
    padding: 0.8rem 1rem;
    border-radius: 0.875rem;
    background: var(--color-ivory);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    font: inherit;
    font-size: 1rem;
    color: var(--color-pine);
    transition: box-shadow 0.2s ease;
  }
  textarea {
    min-height: 9.5rem;
    resize: vertical;
    line-height: 1.55;
  }
  input:hover,
  textarea:hover {
    box-shadow: inset 0 0 0 1px var(--color-pine);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    box-shadow:
      inset 0 0 0 1.5px var(--color-pine),
      0 0 0 4px rgb(167 73 52 / 0.25);
  }
  [aria-invalid='true'] {
    box-shadow: inset 0 0 0 1.5px var(--color-terracotta);
  }
  .error {
    min-height: 0;
    font-size: 0.875rem;
    color: var(--color-terracotta-deep);
  }
  .error:empty {
    display: none;
  }
  .hint {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .chip {
    position: relative;
    font-weight: 400;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    font-size: 0.9375rem;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .chip:hover span {
    box-shadow: inset 0 0 0 1px var(--color-pine);
  }
  .chip input:checked + span {
    background: var(--color-pine);
    color: var(--color-ivory);
    box-shadow: inset 0 0 0 1px var(--color-pine);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--color-terracotta);
    outline-offset: 3px;
  }
  .status {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
  .success {
    padding-block: 2rem;
  }
  .success:focus {
    outline: none;
  }
  .success-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: var(--color-pine);
    color: var(--color-ivory);
  }
</style>
