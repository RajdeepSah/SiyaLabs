---
import Logo from '../brand/Logo.astro';
import Mark from '../brand/Mark.astro';
import Icon from '../ui/Icon.astro';
import { SITE } from '../../config/site';
import { services } from '../../data/services';

const year = new Date().getFullYear();
---

<footer class="on-pine relative isolate overflow-hidden">
  <Mark class="footer-mark" />
  <div class="container-site relative pt-20 pb-10 md:pt-28">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="inline-flex rounded-md p-1 -m-1" aria-label="Siya Labs, home">
          <Logo class="h-9 w-auto" />
        </a>
        <p class="muted mt-6 max-w-xs">{SITE.tagline}</p>
        <a href="/contact/" class="btn btn-light mt-8">Get in touch <Icon name="arrow-right" /></a>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-[1.45fr_1fr_1.2fr] lg:col-span-7">
        <div>
          <h2 class="footer-h">Services</h2>
          <ul class="footer-list">
            {
              services.map((s) => (
                <li>
                  <a href={`/services/${s.slug}/`} class="footer-link">
                    {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="footer-h">Company</h2>
          <ul class="footer-list">
            <li><a href="/about/" class="footer-link">About</a></li>
            <li><a href="/contact/" class="footer-link">Contact</a></li>
            <li><a href="/privacy/" class="footer-link">Privacy</a></li>
          </ul>
        </div>
        <div>
          <h2 class="footer-h">Contact</h2>
          <ul class="footer-list">
            <li><a href={`mailto:${SITE.email}`} class="footer-link">{SITE.email}</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div
      class="mt-20 flex flex-col-reverse gap-4 border-t border-line-ivory pt-8 text-sm text-ivory-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Siya Labs. All rights reserved.</p>
      <a href="#top" class="footer-link inline-flex items-center gap-2">
        Back to top <Icon name="arrow-up" class="size-4" />
      </a>
    </div>
  </div>
</footer>

<style>
  :global(.footer-mark) {
    position: absolute;
    z-index: -1;
    right: -7%;
    bottom: -34%;
    width: min(64vw, 760px);
    height: auto;
    color: color-mix(in oklab, var(--color-ivory) 5%, var(--color-pine));
    pointer-events: none;
  }
  .footer-h {
    margin-bottom: 1.1rem;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ivory-muted);
  }
  .footer-list > li + li {
    margin-top: 0.35rem;
  }
  .footer-link {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    color: var(--color-ivory);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.2s ease;
  }
  .footer-link:hover {
    text-decoration-color: currentColor;
  }
</style>
