{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --port 4323 --host 127.0.0.1",
      "startServerReadyPattern": "4323",
      "url": [
        "http://127.0.0.1:4323/",
        "http://127.0.0.1:4323/services/ai-automation/",
        "http://127.0.0.1:4323/about/",
        "http://127.0.0.1:4323/contact/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
